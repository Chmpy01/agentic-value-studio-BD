{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/cognitive-value-twin-site-v2.json",
  "title": "Cognitive Value Twin \u00b7 Building, Evidence and Value Cases \u00b7 v2",
  "description": "Schema for illustrative static-site visualisation. Does not define an operational digital twin or live control interface.",
  "type": "object",
  "required": [
    "name",
    "kind",
    "floors",
    "cases"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "kind": {
      "enum": [
        "office",
        "manufacturing",
        "retail"
      ]
    },
    "label": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "floors": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "area": {
      "type": "number",
      "minimum": 0
    },
    "annualEnergy": {
      "type": "number",
      "minimum": 0
    },
    "annualOperatingCost": {
      "type": "number",
      "minimum": 0
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "partners": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/valueCase"
      }
    },
    "assetId": {
      "type": "string",
      "description": "GLB scene kind from assets/manifest.json"
    },
    "modelVersion": {
      "type": "string"
    },
    "evidenceStatus": {
      "enum": [
        "synthetic",
        "hypothesis",
        "verified"
      ]
    },
    "sceneAnchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "floor",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "floor": {
            "type": "integer"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "valueCase": {
      "type": "object",
      "required": [
        "id",
        "title",
        "layer",
        "floor",
        "x",
        "z"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "enum": [
            "people",
            "space",
            "energy",
            "asset",
            "security",
            "finance",
            "ecosystem"
          ]
        },
        "floor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "x": {
          "type": "number",
          "minimum": -20,
          "maximum": 20
        },
        "z": {
          "type": "number",
          "minimum": -20,
          "maximum": 20
        },
        "unit": {
          "type": "string"
        },
        "stakeholder": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "hypothesis": {
          "type": "string"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "illustrative": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "string"
        },
        "partner": {
          "type": "string"
        },
        "cisco": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "classification": {
              "enum": [
                "synthetic",
                "hypothesis",
                "verified"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "asOf": {
              "type": "string",
              "format": "date"
            },
            "owner": {
              "type": "string"
            }
          }
        },
        "assetNode": {
          "type": "string",
          "description": "Optional named mesh in glTF file, e.g. Floor_2; value-case x/z remains authoritative"
        },
        "verification": {
          "type": "object",
          "properties": {
            "baselinePeriod": {
              "type": "string"
            },
            "counterfactualMethod": {
              "type": "string"
            },
            "measurementOwner": {
              "type": "string"
            },
            "benefitOwner": {
              "type": "string"
            },
            "confidenceScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "overlapsWith": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}